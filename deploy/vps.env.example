# Copy to .env.docker in the project root. Never commit the filled file.
WAYANG_ENV=production
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WAYANG_SERVICE_TOKEN=
WAYANG_ALLOWED_HOSTS=127.0.0.1,localhost
WAYANG_PUBLIC_DOCS=false
WAYANG_ENABLE_CHAT=true
WAYANG_MAX_CONCURRENCY=1
WAYANG_RATE_LIMIT=60

WAYANG_MODEL_DIR=/data/model_clip_b32_bab4_early_stopping
WAYANG_DB_PATH=/data/wayang_db.json
WAYANG_CHROMA_DIR=/data/chroma_db_wayang
WAYANG_IMAGE_ROOT=/data/dataset_asli
WAYANG_EMBEDDING_LOCAL_ONLY=true
# Set a verified cached commit matching the original Chroma embeddings.
WAYANG_EMBEDDING_REVISION=

# Empty key retains the existing local fallback. Web search requires a real key.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=

# Set these to the public domain and HTTPS port when using the reverse proxy.
STREAMLIT_BROWSER_SERVER_ADDRESS=localhost
STREAMLIT_BROWSER_SERVER_PORT=8501
