# Default Google Colab; untuk lokal, ganti dengan lokasi artefak asli.
WAYANG_MODEL_DIR=/content/drive/MyDrive/skripsi_wayang/model_clip_b32_terbaik
WAYANG_DB_PATH=/content/drive/MyDrive/skripsi_wayang/wayang_db.json
WAYANG_MAX_UPLOAD_BYTES=10485760
WAYANG_CHROMA_DIR=/content/drive/MyDrive/skripsi_wayang/chroma_db_wayang
WAYANG_COLLECTION=wayang_sasak
# Default threshold berasal dari fixture lokal; kalibrasikan lagi di Colab.
# WAYANG_SEARCH_THRESHOLD=nilai_hasil_kalibrasi
# Harus sesuai proses encode saat collection asli dibuat.
WAYANG_NORMALIZE_EMBEDDINGS=false
# Kosong: chat tetap memakai fallback deterministik. Jangan commit key asli.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_ATTEMPTS=2
