# Lokasi model baru dalam folder proyek; sesuaikan bila artefak berada di tempat lain.
WAYANG_MODEL_DIR=artifacts/model_clip_b32_bab4_early_stopping
WAYANG_DB_PATH=/content/drive/MyDrive/skripsi_wayang/wayang_db.json
# Folder dataset_asli untuk gambar utama di chat (opsional bila di sebelah JSON).
WAYANG_IMAGE_ROOT=
WAYANG_MAX_UPLOAD_BYTES=10485760
# Acceptance thresholds, bukan temperature atau confidence cap; equality diterima.
WAYANG_MIN_CONFIDENCE=0.85
WAYANG_MIN_MARGIN=0.20
WAYANG_CHROMA_DIR=/content/drive/MyDrive/skripsi_wayang/chroma_db_wayang
WAYANG_COLLECTION=wayang_sasak
# Initial calibrated threshold artefak asli Colab; belum ada holdout terpisah.
WAYANG_SEARCH_THRESHOLD=0.5590755322575569
# Harus sesuai proses encode saat collection asli dibuat.
WAYANG_NORMALIZE_EMBEDDINGS=false
# Development/Colab bootstrap boleh download fixed identifier; production selalu local-only.
WAYANG_EMBEDDING_LOCAL_ONLY=false
# Pin commit yang cocok dengan embedding ChromaDB asli sebelum deployment publik.
WAYANG_EMBEDDING_REVISION=
# Opt-in Tahap 3; false retains the Stage 2 default application.
WAYANG_ENABLE_CHAT=false
WAYANG_ENV=development
WAYANG_SERVICE_TOKEN=
WAYANG_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
WAYANG_CORS_ORIGINS=
WAYANG_PUBLIC_DOCS=false
WAYANG_RATE_LIMIT=60
WAYANG_MAX_CONCURRENCY=2
WAYANG_MAX_PIXELS=16000000
# Kosong: chat tetap memakai fallback deterministik. Jangan commit key asli.
WAYANG_WEB_CACHE_TTL_SECONDS=900
WAYANG_WEB_CACHE_MAX_ENTRIES=32

# Narasi lokal dan pencarian web sama-sama memakai LLM_API_KEY.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=2

# OpenAI web_search; tidak membutuhkan key terpisah.
WEB_TIMEOUT_SECONDS=45
WEB_MAX_ATTEMPTS=2
